{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Completed HTTP requests per second: incoming POST /orders/{orderId}/payment versus outgoing POST /external/process. Includes all HTTP statuses and outgoing network failures. Outgoing requests are counted on completion, not submission; the gap is a throughput difference, not queue size.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\",method=\"POST\",uri=\"/orders/{orderId}/payment\"}[$__rate_interval]))",
          "legendFormat": "Incoming {{service}} \u2014 payment endpoint",
          "refId": "A"
        },
        {
          "expr": "sum by (service) (rate(http_client_requests_seconds_count{service=~\"$service\",method=\"POST\",uri=\"/external/process\"}[$__rate_interval]))",
          "legendFormat": "Outgoing {{service}} \u2014 payment system",
          "refId": "B"
        }
      ],
      "title": "Payment RPS: incoming vs outgoing",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current number of payment slots held while waiting or processing. Includes background work after HTTP 200. Requests rejected with HTTP 429 do not occupy slots. Slots are released on completion or failure. Values are sampled at the Prometheus scrape interval.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "lineInterpolation": "stepAfter",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (payment_inflight{service=~\"$service\"})",
          "legendFormat": "Unfinished {{service}}",
          "refId": "A"
        }
      ],
      "title": "Unfinished accepted payments",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 40,
  "tags": [
    "payments"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": []
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(service)",
        "includeAll": true,
        "name": "service",
        "label": "Service",
        "options": [],
        "query": {
          "query": "label_values(service)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Payment observability",
  "uid": "payment-observability",
  "version": 1
}
